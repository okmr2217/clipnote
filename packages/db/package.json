{
  "name": "@clipnote/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:create:local": "wrangler d1 create clipnote-db",
    "db:migrate:local": "wrangler d1 migrations apply clipnote-db --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply clipnote-db --remote",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
