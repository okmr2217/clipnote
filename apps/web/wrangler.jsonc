{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipnote-web",
  // .open-next/worker.js（OpenNextのビルド成果物）が公開するfetchハンドラを
  // そのまま使いつつ、ゴミ箱の自動パージ用scheduled()を追加するための薄い
  // ラッパー（docs/design-trash.md 6章）。src/custom-worker.ts参照。
  "main": "src/custom-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // ゴミ箱の30日超過分を物理削除する日次バッチ（毎日18:00 UTC=JST 03:00）。
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  // 設計書1章：Web本体ドメイン。Custom Domainsとしてparitto.devゾーンに接続する
  // （DNSレコード・SSL証明書はCloudflareが自動でプロビジョニングする）。
  "routes": [{ "pattern": "clipnote.paritto.dev", "custom_domain": true }],
  // better-authのbaseURL解決に使う（src/lib/auth.ts参照）。origin-check
  // ミドルウェアがこのオリジンをtrustedOriginsへ組み込むために必須。
  "vars": {
    "BETTER_AUTH_URL": "https://clipnote.paritto.dev",
    // お問い合わせ・公開コンテンツの通報の送信先（src/lib/email.ts）。機密情報
    // ではないためvarsで管理する。運営が受信できるアドレスに変更可能。
    "CONTACT_EMAIL_TO": "okumuradaichi2007@gmail.com",
    // `/ops`（運営者向けユーザー一覧、src/lib/ops-auth.ts）をCloudflare
    // Accessで保護するための検証パラメータ。いずれも秘密情報ではない
    // （JWT検証用の公開鍵取得先・Access Application識別子）ためvarsで管理
    // する。Zero Trustダッシュボードの対象Applicationの「Overview」タブ
    // から実際の値に置き換えること。
    "CF_ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "CF_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // パスワードリセット・メール確認の送信に使用（src/lib/email.ts）。送信元
  // ドメイン（paritto.dev）のCloudflare Email Sending有効化は別途手動作業。
  "send_email": [{ "name": "EMAIL" }],
  // Same D1 database as packages/db (which owns the schema/migrations,
  // see packages/db/wrangler.jsonc). better-auth reads/writes users,
  // sessions, accounts, verifications through this binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipnote-db",
      "database_id": "285e1a62-521d-4427-8799-a0c4b8710012",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
