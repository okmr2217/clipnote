BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# apps/contentの.dev.vars（.dev.vars.example参照）と同じ値にすること
# （設計書4-4節：両ドメイン共通のHMAC署名鍵）。本番はwrangler secret putで設定する。
CONTENT_TOKEN_SECRET=
# apps/content（clipnote-content Worker）のオリジン。ローカルは`wrangler dev`が
# 出力するhost:portに合わせる（apps/content/.dev.vars.exampleのCONTENT_HOSTと対応）。
# ビルド時に埋め込まれる値のため、本番ビルドの実行環境にも設定が必要。
NEXT_PUBLIC_CONTENT_ORIGIN=http://localhost:8787
